# Instalacja na stacji: skopiuj do ~/Desktop (ikona) i do ~/.config/autostart (otwiera się po starcie):
#   cp rpi-ground/stratosteam-odbior.desktop ~/Desktop/ ~/.config/autostart/
[Desktop Entry]
Type=Application
Name=StratoSTEAM — odbiór danych
Comment=Dane odbierane z balonu przez LoRa
Exec=python3 /home/admin/StratoSTEAM/rpi-ground/gui_odbior.py
Path=/home/admin/StratoSTEAM/rpi-ground
Icon=network-wireless
Terminal=false
Categories=Utility;
