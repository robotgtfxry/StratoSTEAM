[Unit]
Description=StratoSTEAM ground station
After=network.target
# Bez SPI (LoRa: spidev0.0) main.py nie wystartuje
ConditionPathExists=/dev/spidev0.0

[Service]
# STRATO_BACKEND_URL i STRATO_API_KEY
EnvironmentFile=-/etc/stratosteam.env
# main.py loguje do /var/log, a działa jako zwykły użytkownik ("+" = root)
ExecStartPre=+/usr/bin/touch /var/log/stratosteam-ground.log
ExecStartPre=+/usr/bin/chown admin:admin /var/log/stratosteam-ground.log
ExecStart=/usr/bin/python3 /home/admin/StratoSTEAM/rpi-ground/main.py
WorkingDirectory=/home/admin/StratoSTEAM/rpi-ground
Restart=always
RestartSec=5
User=admin

[Install]
WantedBy=multi-user.target
