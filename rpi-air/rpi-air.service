[Unit]
Description=StratoSTEAM air node
After=multi-user.target

[Service]
ExecStart=/home/admin/StratoSTEAM/rpi-air/.venv/bin/python /home/admin/StratoSTEAM/rpi-air/main.py
WorkingDirectory=/home/admin/StratoSTEAM/rpi-air
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
User=admin

[Install]
WantedBy=multi-user.target
